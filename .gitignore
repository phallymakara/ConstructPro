# ==============================================================================
# ConstructPro - Root .gitignore
# ==============================================================================

# Operating System & Environment Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.prod.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Backend (Python / FastAPI / uv)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Local SQLite / Databases
*.db
*.sqlite
*.sqlite3
constructpro.db

# ------------------------------------------------------------------------------
# Frontend (Node / React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
.vite-temp/
frontend/.vite/
frontend/.vite-temp/

# ------------------------------------------------------------------------------
# Agent / Temporary Artifacts
# ------------------------------------------------------------------------------
.agents/
.gemini/
